__pycache__/
*.pyc
.pytest_cache/
data/donor_pairs/**/*.h5ad
data/donor_pairs/**/*.mtx*
data/donor_pairs/**/*.mtx.gz
data/tmp/
*.log
manuscript/*.aux
manuscript/*.out
manuscript/*.fls
manuscript/*.fdb_latexmk
manuscript/*.synctex.gz

# KEEP-LOCAL belt (large-file-governance §3.4). data/plotdata/ is the tracked
# rebuild SSOT; everything else under data/ is re-fetchable or re-derivable.
data/external/
data/donor_pairs/
.omc/
.omx/
.claude/

# Local working notes: byline/strategy scratch, never tracked or published.
*.local.md

# Derived from data/plotdata/ by manuscript/scripts; not a truth source.
manuscript/figs/rendered/
manuscript/*.pdf
manuscript/*.bbl
manuscript/*.blg
manuscript/main_diff_V2_to_V3.tex
# The unmarked flattened copy the highlight build uses to restore its tables.
manuscript/main_diff_new_flat.tex
# Rendered from cover_letter.md by build_cover_letter.py; the markdown is source.
manuscript/cover_letter.txt

# Internal licence evidence: contains a provider-confidential agreement copy.
# Never publish; kept out of the public release.
revision_v3/license/

# Rebuilt from the editing copy by scripts/28_assemble_submission.py. The
# assembler is the tracked artifact; the capsule is its output.
submission/

# Rebuilt from data/plotdata/, locks/ and manuscript/scripts/ by
# scripts/29_assemble_supplementary.py. The capsule assembler empties
# submission/, so the reviewer archive is written beside its own bundle.
supplementary/
supplementary.zip

# Reviewer responses: kept local for portal upload, not published.
responses/
